{
  "name": "fntu-discord-bot",
  "version": "0.1.0",
  "private": true,
  "description": "A maintainable Discord bot for the FNTU community.",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "npm run typecheck && npm run lint && npm run migrations:check && npm run test",
    "command:create": "tsx src/scripts/generate-command.ts",
    "config:validate": "tsx src/scripts/validate-guild-config.ts",
    "deploy:commands": "tsx src/scripts/deploy-commands.ts",
    "dev": "tsx watch src/bootstrap/start.ts",
    "dev:once": "tsx src/bootstrap/start.ts",
    "db:generate": "drizzle-kit generate && tsx src/scripts/normalize-postgres-migrations.ts",
    "db:import-files": "tsx src/scripts/import-file-persistence.ts",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:active": "tsx src/scripts/migrate-active-database.ts",
    "db:studio": "drizzle-kit studio",
    "lint": "eslint .",
    "migrations:check": "tsx src/scripts/normalize-postgres-migrations.ts --check",
    "local:bot": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/local-bot.ps1",
    "local:check-token": "tsx src/scripts/check-discord-token.ts",
    "local:lavalink": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/local-lavalink.ps1",
    "local:postgres": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/local-postgres.ps1",
    "local:setup": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/local-setup.ps1",
    "local:start": "tsx src/scripts/start-default.ts",
    "instance:check-token": "tsx src/scripts/check-instance-token.ts",
    "instance:config:validate": "tsx src/scripts/validate-instance-config.ts",
    "instance:db:migrate": "tsx src/scripts/migrate-instance-database.ts",
    "instance:deploy": "tsx src/scripts/deploy-instance-commands.ts",
    "instance:emojis:sync": "tsx src/scripts/sync-instance-emojis.ts",
    "instance:init": "tsx src/scripts/initialize-instance.ts",
    "instance:promote-default": "tsx src/scripts/promote-default-instance.ts",
    "instance:start": "tsx src/scripts/start-instance.ts",
    "instances:validate": "tsx src/scripts/validate-instances.ts",
    "instances:start": "tsx src/scripts/start-instances.ts",
    "instances:start:local": "tsx src/scripts/start-all.ts",
    "services:start": "concurrently --kill-others --names postgres,lavalink --prefix-colors green,magenta \"npm:local:postgres\" \"npm:local:lavalink\"",
    "services:start:docker": "docker compose up -d --wait postgres lavalink",
    "stack:config": "docker compose config",
    "stack:down": "docker compose down --remove-orphans",
    "stack:deploy": "npm run stack:deploy:yohta && npm run stack:deploy:pinecone",
    "stack:deploy:pinecone": "docker compose run --rm --no-deps bot-pinecone node dist/scripts/deploy-commands.js",
    "stack:deploy:yohta": "docker compose run --rm --no-deps bot-yohta node dist/scripts/deploy-commands.js",
    "stack:logs": "docker compose logs -f",
    "stack:reset": "tsx src/scripts/reset-docker-postgres.ts",
    "stack:restart:bot": "docker compose restart bot-yohta bot-pinecone",
    "stack:up": "docker compose up --build -d --wait --remove-orphans",
    "start": "node dist/bootstrap/start.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.18.0",
    "better-sqlite3": "^13.0.3",
    "discord.js": "^14.16.0",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.45.2",
    "lavalink-client": "^2.9.7",
    "pino": "^9.6.0",
    "postgres": "^3.4.9",
    "uwuifier": "^4.2.2",
    "yaml": "^2.8.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.10.0",
    "concurrently": "^10.0.4",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.17.0",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.2",
    "vitest": "^4.1.10"
  }
}
