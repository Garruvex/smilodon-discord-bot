# Copy to config/instances/<instance-name>.env. The filename is the argument
# accepted by instance:* scripts. Real .env files in this directory are ignored.
INSTANCE_NAME=bot-name

DISCORD_TOKEN=
DISCORD_APPLICATION_ID=
# Trusted operators of this bot application, not guild/server administrators.
# They can bypass normal guild policy for recovery and diagnostics.
BOT_OWNER_IDS=

PERSISTENCE_DRIVER=postgres
# PostgreSQL always uses a schema derived from INSTANCE_NAME. Multiple
# instances may safely share this DATABASE_URL.

# These locations must be unique for every Discord application.
GUILD_CONFIG_DIRECTORY=./config/local/instances/bot-name/guilds
RUNTIME_DATA_DIRECTORY=./data/instances/bot-name

# Optional mention-chat provider. Unlike the settings above, CHATBOT_*/
# UTILITY_*/OPENAI_*/GOOGLE_* are never inherited from the root .env — leave
# every line below commented to keep chat disabled for this instance.
# Credentials are shared by the main and utility tasks within this instance.
# OPENAI_API_KEY=
# Override only for an OpenAI-compatible third-party endpoint.
# OPENAI_BASE_URL=
# GOOGLE_API_KEY=
# CHATBOT_MODEL enables mention chat; fallback models are comma-separated.
# CHATBOT_MODEL=
# CHATBOT_PROVIDER=openai
# CHATBOT_MODE=chat_completions
# CHATBOT_FALLBACK_MODELS=
# Independent vector provider; may differ from CHATBOT_PROVIDER. If set to
# gemini, EMBEDDING_MODEL must be gemini-embedding-001 (native 3072-dim,
# truncated to match schema.ts's fixed embeddingDimensions=1536) — NOT
# text-embedding-004, whose native/max 768 dimensions can't be padded up to
# 1536 and will fail (Postgres) or silently produce useless zero-similarity
# comparisons (SQLite) — see GeminiEmbeddingsClient's constructor comment.
# EMBEDDING_PROVIDER=openai
# EMBEDDING_MODEL=
# Optional cheaper model for structured extraction and summarization.
# CHATBOT_SUMMARY_MODEL=
# CHATBOT_SUMMARY_FALLBACK_MODELS=
# Separate structured-summary budget; Responses counts reasoning and visible JSON together.
# CHATBOT_SUMMARY_REASONING_EFFORT=low
# CHATBOT_SUMMARY_MAX_OUTPUT_TOKENS=4096
# Provider-specific generation settings.
# CHATBOT_REASONING_EFFORT=low
# CHATBOT_VERBOSITY=low
# CHATBOT_MAX_OUTPUT_TOKENS=2048
# CHATBOT_GEMINI_THINKING_BUDGET=
# Optional independent provider/model for structured utility calls.
# UTILITY_MODEL=
# UTILITY_PROVIDER=openai
# UTILITY_MODE=chat_completions
# UTILITY_FALLBACK_MODELS=
# UTILITY_REASONING_EFFORT=low
# UTILITY_VERBOSITY=low
# UTILITY_MAX_OUTPUT_TOKENS=2048
# UTILITY_GEMINI_THINKING_BUDGET=
# Memory-engine tunables (see MemoryEngineLimits in
# src/application/memory/memory-engine.ts for what each one controls).
# Defaults target OpenAI text-embedding-3-small — if EMBEDDING_PROVIDER/
# EMBEDDING_MODEL above point at a different embedding model, recalibrate
# MEMORY_CONFLICT_SIMILARITY_THRESHOLD; cosine-similarity baselines are not
# portable across embedding models.
# MEMORY_MAX_SELECTED_CHARS=8000
# MEMORY_MAX_STATEMENT_CHARS=200
# MEMORY_MAX_SLOT_CHARS=60
# MEMORY_MAX_TOPIC_CHARS=60
# MEMORY_CONFLICT_SIMILARITY_THRESHOLD=0.75
# Bounded multi-hop relational retrieval (memory_relations table) — how far
# to expand from the turn's mentioned subjects, and how strongly a
# connection nudges recall ranking (decayed per hop: base/hopDistance).
# MEMORY_MAX_RELATION_HOPS=2
# MEMORY_RELATION_HOP_BOOST_BASE=3

# Optional overrides. Unlike the block above, these DO inherit shared values
# from the root .env when omitted.
# LAVALINK_HOST=127.0.0.1
# LAVALINK_PORT=2333
# LAVALINK_PASSWORD=
