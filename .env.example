NODE_ENV=development
LOG_LEVEL=debug

# Default application overlay used by legacy commands such as local:start and
# deploy:commands. This loads config/instances/pinecone.env.
DEFAULT_INSTANCE=pinecone

# Shared PostgreSQL server bootstrap. Each application keeps its own
# PERSISTENCE_DRIVER and DATABASE_URL in config/instances/<name>.env.
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

LAVALINK_HOST=127.0.0.1
LAVALINK_PORT=2333
LAVALINK_PASSWORD=
LAVALINK_SECURE=false

# Optional. Leave empty unless Lavalink YouTube OAuth is configured.
YOUTUBE_REFRESH_TOKEN=

# Spotify Web API application credentials used by LavaSrc to resolve Spotify
# tracks, albums, and playlists. Spotify audio is mirrored through a playable
# provider such as YouTube or SoundCloud.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Optional mention-chat provider. Configure all three together. xAI, OpenAI,
# and other OpenAI-compatible /chat/completions APIs can use this adapter.
CHAT_API_KEY=
CHAT_BASE_URL=
CHAT_MODEL=
CHAT_API_MODE=chat_completions
