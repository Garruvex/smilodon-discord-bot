NODE_ENV=development
LOG_LEVEL=debug

# All Docker-owned persistent state lives below this host directory:
# postgres/, lavalink/, and instances/<name>/.
DATA_ROOT=./data

# Docker application. This loads config/instances/<name>.env.
DOCKER_INSTANCE=bot

# The application selected by native commands without an explicit instance
# name. Docker uses DOCKER_INSTANCE instead.
DEFAULT_INSTANCE=bot

# Shared PostgreSQL server bootstrap for Docker and local infrastructure.
# Native persistence still belongs in config/instances/<name>.env. Docker maps
# the selected instance to this shared database with an isolated schema.
POSTGRES_DB=fntu_bot
POSTGRES_USER=fntu_bot
POSTGRES_PASSWORD=
# Optional host-port override when 5432 is already occupied.
POSTGRES_PORT=5432

LAVALINK_HOST=127.0.0.1
LAVALINK_PORT=2333
LAVALINK_PASSWORD=
LAVALINK_SECURE=false

# Optional. Leave empty unless Lavalink YouTube OAuth is configured.
YOUTUBE_REFRESH_TOKEN=

# Spotify Web API application credentials used by LavaSrc to resolve Spotify
# tracks, albums, and playlists. Spotify audio is mirrored through a playable
# provider such as YouTube or SoundCloud.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
